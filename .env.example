# Environment variables for CodeChef Class Performance Tracker

# Flask configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Database configuration
# Use SQLite for development, MySQL for production
# For MySQL: DATABASE_URL=mysql+pymysql://username:password@localhost/codechef_tracker
DATABASE_URL=sqlite:///instance/codechef_tracker.db

# CodeChef API configuration
# The application uses URL-based extraction currently
# For third-party API integration, configure accordingly
CODECHEF_BASE_URL=https://www.codechef.com

# Application settings
ADMIN_EMAIL=admin@codecheftracker.local
ADMIN_PASSWORD=change-this-default

# Scheduler configuration
# APScheduler settings
SCHEDULER_API_ENABLED=True
SCHEDULER_TIMEZONE=Asia/Kolkata